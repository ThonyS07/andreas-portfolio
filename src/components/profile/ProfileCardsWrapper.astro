---
import HomeCard from "../cards/homeCard/HomeCard.astro";
import FamiliaIcon from "../cards/homeCard/icons/FamiliaIcon.astro";
import ViajesIcon from "../cards/homeCard/icons/ViajesIcon.astro";
import PersonasIcon from "../cards/homeCard/icons/PersonasIcon.astro";
import ConversacionesIcon from "../cards/homeCard/icons/ConversacionesIcon.astro";
---

<div
	class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 auto-rows-fr items-center justify-center dark:text-blanco text-negro3 w-full max-w-[328px] md:max-w-[680px] lg:max-w-none gap-6'>
	<HomeCard
		titulo='Familia'
		text='Soy un miembro feliz de una gran familia, sin duda es parte de mi identidad laboral tambien.'>
		<FamiliaIcon />
	</HomeCard>
	<HomeCard
		titulo='Danza'
		text='He sido participante de distintos elencos de danza, donde aprendí a ser parte de un equipo.'>
		<PersonasIcon />
	</HomeCard>
	<HomeCard
		titulo='Viajes'
		text='Amo con locura viajar y conocer diferentes culturas, esto ayuda mucho a mi curiosidad'>
		<ViajesIcon />
	</HomeCard>
	<HomeCard
		titulo='Conversaciones'
		text='Me gusta mucho conversar, encuentro fascinante conocer que hay en las cabezas de las personas'>
		<ConversacionesIcon />
	</HomeCard>
</div>
