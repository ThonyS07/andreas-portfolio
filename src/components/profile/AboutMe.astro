---
import { TextL1 } from "../../format/LightTypography";
import { HeaderBl5, TextBl1 } from "../../format/BlackTypography";
import ProfileCardsWrapper from "./ProfileCardsWrapper.astro";
import SoftSkills from "./SoftSkills.astro";
import HardSkills from "./HardSkills.astro";
import Experience from "./Experience.astro";
---

<div
	class='flex flex-col w-full items-center mt-[62px] mb-12 md:mb-[70px] md:mt-[50px] lg:mb-16 lg:mt-[58px] xl:mb-14 xl:mt-16 dark:text-blanco text-negro3'>
	<div class='flex flex-col max-[768px]:mb-10 mb-14 w-full items-center'>
		<div class='mb-8 flex flex-col items-center'>
			<TextL1>Quien soy</TextL1>
			<HeaderBl5>Sobre mí</HeaderBl5>
		</div>
		<ProfileCardsWrapper />
	</div>
	<div class='flex flex-col w-full justify-center items-center'>
		<div class='flex w-full mb-8 justify-center items-center'>
			<TextBl1>Mi experiencia como UX</TextBl1>
		</div>
		<div class='flex'>
			<Experience />
		</div>
	</div>
	<div class='flex flex-col mb-6 md:mb-8 w-full justify-center items-center'>
		<TextBl1>Mis habilidades blandas</TextBl1>
		<div class='mt-8'>
			<SoftSkills />
		</div>
	</div>
	<div class='flex flex-col mb-6 md:mb-8 w-full justify-center items-center'>
		<TextBl1>Mis habilidades duras</TextBl1>
		<div class=''>
			<HardSkills />
		</div>
	</div>
</div>
